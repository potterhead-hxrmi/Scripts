-- ─────────────────────────────────────────────────────────────
-- Money parser ("1.5K" -> 1500)
-- ─────────────────────────────────────────────────────────────
local SUF = { [""]=1, K=1e3, M=1e6, B=1e9, T=1e12, Qa=1e15, Qi=1e18,
              Sx=1e21, Sp=1e24, Oc=1e27, No=1e30, De=1e33 }
local function parseMoney(s)
    if type(s) ~= "string" then return nil end
    s = s:gsub("%$",""):gsub(",",""):gsub("%s","")
    local num, suf = s:match("^([%d%.%-]+)(%a*)$")
    if not num then return nil end
    local n = tonumber(num); if not n then return nil end
    return n * (SUF[suf] or 1)
end

