local function doCopy()
    local text = table.concat(LOG, "\n")
    local ok = pcall(function()
        if setclipboard then
            setclipboard(text)
        elseif toclipboard then
            toclipboard(text)
        else
            error("no clipboard function")
        end
    end)
    copiedLbl.Text = ok
        and ("✅ copied %d lines"):format(#LOG)
        or  "❌ clipboard unavailable"
    task.delay(2, function() copiedLbl.Text = "" end)
end

btn.MouseButton1Click:Connect(doCopy)
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.C then doCopy() end
end)

-- ─────────────────────────────────────────────────────────────
-- RF HOOK
-- ─────────────────────────────────────────────────────────────
local RF_PATH = ReplicatedStorage
    :WaitForChild("Packages")._Index["sleitnick_knit@1.6.0"]
    .knit.Services.PlantRoundService.RF
local function getRF(n)
    local ok, v = pcall(function() return RF_PATH:WaitForChild(n, 10) end)
    return ok and v or nil
end
local StartRF = getRF("StartRound")
local StopRF  = getRF("StopPlant")
local DeadRF  = getRF("CollectDeadTree")

local STATE = { active=false, startT=0, samples={}, seed=nil }

local function findTree()
    local best, bestVol
    for _, d in workspace:GetChildren() do
        if d:IsA("Model") and d.Name ~= "TreeGhost" then
            if d.Name:lower():find("tree") or d:FindFirstChild("FruitSpawns") then
                local _, size = d:GetBoundingBox()
                local vol = size.X * size.Y * size.Z
                if vol > 0 and (not bestVol or vol > bestVol) then
                    best, bestVol = d, vol
                end
            end
        end
    end
    return best
end

local function heightOf(model)
    if not model then return nil end
    local _, size = model:GetBoundingBox()
    return size.Y
end

local function dumpTrail(tag)
    local n = #STATE.samples
    if n == 0 then
        log(("[tracker] %s — no samples"):format(tag))
        return
    end
    log("── START ──")
    log(("seed=%s  duration=%.2fs  samples=%d"):format(tostring(STATE.seed), STATE.samples[n].t, n))

    local parts = {}
    for _, s in STATE.samples do
        table.insert(parts, ("%.2f:%.3f"):format(s.t, s.h))
    end
    for i = 1, #parts, 5 do
        local chunk = {}
        for j = i, math.min(i+4, #parts) do
            table.insert(chunk, parts[j])
        end
        log("  " .. table.concat(chunk, "  "))
    end

    if n >= 3 then
        local tSum, hSum, ttSum, thSum = 0, 0, 0, 0
        for _, s in STATE.samples do
            tSum = tSum + s.t
            hSum = hSum + s.h
            ttSum = ttSum + s.t*s.t
            thSum = thSum + s.t*s.h
        end
        local denom = n*ttSum - tSum*tSum
        local slope = denom ~= 0 and (n*thSum - tSum*hSum) / denom or 0
        local intercept = (hSum - slope*tSum) / n
        log(("fit: h = %.4f * t + %.4f   (slope %.4f/s)")
            :format(slope, intercept, slope))
    end

    log("── END ──")
end

do
    local mt = getrawmetatable(game)
    if mt then
        local old = mt.__namecall
        setreadonly(mt, false)
        mt.__namecall = newcclosure(function(self, ...)
            if getnamecallmethod() == "InvokeServer"
            and (self == StartRF or self == StopRF or self == DeadRF) then
                local args = { ... }
                local rets = { old(self, ...) }
                if self == StartRF then
                    STATE.active = true
                    STATE.startT = now()
                    STATE.samples = {}
                    STATE.seed = args[1] or "?"
                    log(("[tracker] 🟢 START seed=%s fert=%s")
                        :format(tostring(args[1]), tostring(args[2])))
                elseif self == StopRF then
                    STATE.active = false
                    dumpTrail("StopPlant (early)")
                elseif self == DeadRF then
                    STATE.active = false
                    dumpTrail("STRIKE")
                end
                return table.unpack(rets)
            end
            return old(self, ...)
        end)
        setreadonly(mt, true)
    end
end

task.spawn(function()
    while true do
        task.wait(0.25)
        if STATE.active then
            local h = heightOf(findTree())
            if h then
                table.insert(STATE.samples, { t = now() - STATE.startT, h = h })
                hLbl.Text = ("h: %.3f"):format(h)
                infoLbl.Text = ("t: %.2fs  samples: %d"):format(now() - STATE.startT, #STATE.samples)
            end
        end
    end
end)

