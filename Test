btn.BorderSizePixel = 0
btn.Parent = panel
Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

-- ─────────────────────────────────────────────────────────────
-- STATE
-- ─────────────────────────────────────────────────────────────
local STATE = {
    armed = true,
    fires = 0,
    lastFireT = 0,
    lastReason = "",
    signalsSeen = 0,
    roundActive = false,
}

local RF_PATH = ReplicatedStorage
    :WaitForChild("Packages")._Index["sleitnick_knit@1.6.0"]
    .knit.Services.PlantRoundService.RF

local function getRF(n)
    local ok, v = pcall(function() return RF_PATH:WaitForChild(n, 10) end)
    return ok and v or nil
end

local StartRF = getRF("StartRound")
local StopRF  = getRF("StopPlant")
local DeadRF  = getRF("CollectDeadTree")

-- ─────────────────────────────────────────────────────────────
-- FIRE REFLEX
-- The whole point: call StopPlant the millisecond we get a signal.
-- Synchronous, no delays, no task.spawn.
-- ─────────────────────────────────────────────────────────────
local function fire(reason)
    if not STATE.armed then return end
    local t = os.clock()
    -- extremely light debounce — just stops duplicate signals in the same tick
    if t - STATE.lastFireT < 0.05 then return end
    STATE.lastFireT = t
    STATE.fires = STATE.fires + 1
    STATE.lastReason = reason

    log(("[reflex] 🔥 FIRE #%d @ %.3f — %s"):format(STATE.fires, t, reason))

    -- fire synchronously. If StopPlant errors, note it.
    local ok, err = pcall(function()
        if StopRF then
            StopRF:InvokeServer()
        end
    end)
    if not ok then
        log(("[reflex]   StopPlant failed: %s"):format(tostring(err)))
    else
        log("[reflex]   StopPlant ok")
    end

    lastLbl.Text = ("last: %s"):format(reason)
end

-- ─────────────────────────────────────────────────────────────
-- SIGNAL 1 — LightningBolt.strike hook
-- ─────────────────────────────────────────────────────────────
do
    local ok, mod = pcall(function()
        return require(ReplicatedStorage.Shared.Utility.LightningBolt)
    end)
    if ok and type(mod) == "table" and type(mod.strike) == "function" then
        local orig = mod.strike
        mod.strike = function(a, b, o)
            STATE.signalsSeen = STATE.signalsSeen + 1
            fire("bolt(strike)")
            return orig(a, b, o)
        end
        log("[reflex] ✔ hooked LightningBolt.strike")
    else
        log("[reflex] ✗ could not hook LightningBolt.strike")
    end
end

-- ─────────────────────────────────────────────────────────────
-- SIGNAL 2 — any bolt-like model spawning in workspace
-- ─────────────────────────────────────────────────────────────
do
    local names = { Lightning = true, Bolt = true, Strike = true, VFX = true }
    workspace.DescendantAdded:Connect(function(d)
        if not STATE.armed then return end
        local n = tostring(d.Name)
        if names[n] or n:lower():find("bolt") or n:lower():find("lightning") then
            STATE.signalsSeen = STATE.signalsSeen + 1
            fire("workspace:" .. n)
        end
    end)
    log("[reflex] ✔ watching workspace for bolt-like parts")
end

-- ─────────────────────────────────────────────────────────────
-- SIGNAL 3 — TreeGhost spawning
-- ─────────────────────────────────────────────────────────────
workspace.ChildAdded:Connect(function(c)
    if c.Name == "TreeGhost" and STATE.armed then
        STATE.signalsSeen = STATE.signalsSeen + 1
        fire("TreeGhost")
    end
end)

-- ─────────────────────────────────────────────────────────────
-- SIGNAL 4 — watch StartRound / StopPlant / CollectDeadTree ourselves
-- so we know when a round is active and can reset
-- ─────────────────────────────────────────────────────────────
do
    local mt = getrawmetatable(game)
    if mt then
        local old = mt.__namecall
        setreadonly(mt, false)
        mt.__namecall = newcclosure(function(self, ...)
            if getnamecallmethod() == "InvokeServer"
            and (self == StartRF or self == StopRF or self == DeadRF) then
                if self == StartRF then
                    STATE.roundActive = true
                    log("[reflex] 🟢 round start")
                elseif self == StopRF then
                    STATE.roundActive = false
                    log("[reflex] ✅ StopPlant invoked")
                elseif self == DeadRF then
                    STATE.roundActive = false
                    log("[reflex] ☠️ CollectDeadTree invoked — round over")
                end
            end
            return old(self, ...)
        end)
        setreadonly(mt, true)
        log("[reflex] ✔ __namecall hooked for round events")
    end
end

-- ─────────────────────────────────────────────────────────────
-- SIGNAL 5 — last-line-of-defense: when a round is active, sample
-- the tree's bbox height every 0.05s. If growth ever STOPS for
-- 2 samples in a row (plateau), fire. That's the split-second
-- before the strike.
-- ─────────────────────────────────────────────────────────────
do
    local lastY, stableCount = nil, 0
    task.spawn(function()
        while true do
            task.wait(0.05)
            if not STATE.armed or not STATE.roundActive then
                lastY, stableCount = nil, 0
            else
                local ap = workspace:FindFirstChild("ActivePlant")
                if ap then
                    local y
                    if ap:IsA("Model") then
                        local _, s = ap:GetBoundingBox()
                        y = s.Y
                    elseif ap:IsA("BasePart") then
                        y = ap.Size.Y
                    end
                    if y then
                        if lastY and math.abs(y - lastY) < 0.001 then
                            stableCount = stableCount + 1
                            if stableCount == 3 then
                                fire("growth plateau")
                            end
                        else
                            stableCount = 0
                        end
                        lastY = y
                    end
                end
            end
        end
    end)
    log("[reflex] ✔ growth plateau watcher running")
end

-- ─────────────────────────────────────────────────────────────
-- HUD updates + hotkeys
-- ─────────────────────────────────────────────────────────────
task.spawn(function()
    while true do
        task.wait(0.2)
        if STATE.armed then
            statusLbl.Text = STATE.roundActive and "ARMED · round active" or "ARMED · idle"
            statusLbl.TextColor3 = Color3.fromRGB(120,255,120)
        else
            statusLbl.Text = "DISARMED"
            statusLbl.TextColor3 = Color3.fromRGB(255,120,120)
        end
        firesLbl.Text = ("fires: %d"):format(STATE.fires)
        sigLbl.Text = ("signals seen: %d"):format(STATE.signalsSeen)
    end
end)

btn.MouseButton1Click:Connect(function()
    local text = table.concat(LOG, "\n")
    pcall(function()
        if setclipboard then setclipboard(text)
        elseif toclipboard then toclipboard(text) end
    end)
    btn.Text = ("copied %d lines"):format(#LOG)
    task.delay(2, function()
        btn.Text = "📋 COPY LOG  (C)   ·   R = arm/disarm"
    end)
end)

UserInputService.InputBegan:Connect(function(i, g)
    if g then return end
    if i.KeyCode == Enum.KeyCode.C then
        local text = table.concat(LOG, "\n")
        pcall(function()
            if setclipboard then setclipboard(text)
            elseif toclipboard then toclipboard(text) end
        end)
    elseif i.KeyCode == Enum.KeyCode.R then
        STATE.armed = not STATE.armed
        log(("[reflex] %s"):format(STATE.armed and "ARMED" or "DISARMED"))
    end
end)

log("[reflex] loaded — FINAL. Press R to toggle, C to copy.")
log("[reflex] 5 signals armed: bolt, workspace, TreeGhost, __namecall, plateau.")
