local function mk(name, y, h, font, size, col)
    local l = Instance.new("TextLabel")
    l.Name = name
    l.BackgroundTransparency = 1
    l.Position = UDim2.new(0, 8, 0, y)
    l.Size = UDim2.new(1, -16, 0, h)
    l.Font = font; l.TextSize = size; l.TextColor3 = col
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.TextYAlignment = Enum.TextYAlignment.Top
    l.TextWrapped = true
    l.Parent = panel
    return l
end

-- drag handle (the whole top strip)
local dragBar = Instance.new("TextButton")
dragBar.Name = "DragBar"
dragBar.BackgroundTransparency = 1
dragBar.Position = UDim2.new(0, 0, 0, 0)
dragBar.Size = UDim2.new(1, 0, 0, 18)
dragBar.Text = ""
dragBar.AutoButtonColor = false
dragBar.Parent = panel

local title = mk("Title", 2, 14, Enum.Font.GothamBold, 12, Color3.fromRGB(200,220,255))
title.Text  = "⚡ LIGHTNING PREDICTOR  ·  drag me"
title.ZIndex = 2

local roundLbl = mk("Round", 18, 14, Enum.Font.GothamBold, 11, Color3.fromRGB(180,140,80))
roundLbl.Text  = "WAITING FOR PLANT"

local countdown = mk("Countdown", 34, 24, Enum.Font.GothamBlack, 19, Color3.fromRGB(120,200,255))
countdown.Text  = "--"

local detail = mk("Detail", 60, 12, Enum.Font.Gotham, 10, Color3.fromRGB(140,150,170))
detail.Text  = "plant a seed to start"

local rollLbl = mk("RollLbl", 74, 20, Enum.Font.Code, 10, Color3.fromRGB(150,200,150))
rollLbl.Text  = "🎲 no rolls yet"

-- ─────────────────────────────────────────────────────────────
-- DRAG (manual, works everywhere)
-- ─────────────────────────────────────────────────────────────
do
    local dragging, dragStart, startPos

    dragBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging  = true
            dragStart = input.Position
            startPos  = panel.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragStart
            panel.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

