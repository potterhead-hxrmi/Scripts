local function mkLbl(y, h, font, size, color, text)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Position = UDim2.new(0, 8, 0, y)
    l.Size = UDim2.new(1, -16, 0, h)
    l.Font = font; l.TextSize = size; l.TextColor3 = color
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.TextYAlignment = Enum.TextYAlignment.Top
    l.TextWrapped = true
    l.Text = text
    l.Parent = panel
    return l
end

local titleLbl  = mkLbl(4, 14, Enum.Font.GothamBold, 12, Color3.fromRGB(255,200,200), "⚡ REFLEX HARVEST — FINAL")
local statusLbl = mkLbl(20, 14, Enum.Font.GothamBold, 11, Color3.fromRGB(120,255,120), "ARMED")
local firesLbl  = mkLbl(36, 14, Enum.Font.Code, 11, Color3.fromRGB(255,220,140), "fires: 0")
local lastLbl   = mkLbl(52, 20, Enum.Font.Code, 10, Color3.fromRGB(200,200,200), "last: --")
local sigLbl    = mkLbl(72, 24, Enum.Font.Code, 10, Color3.fromRGB(150,200,150), "signals: 0")

local btn = Instance.new("TextButton")
btn.Position = UDim2.new(0, 8, 1, -30)
