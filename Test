local function doCopy()
    local text = table.concat(LOG, "\n")
    pcall(function()
        if setclipboard then setclipboard(text)
        elseif toclipboard then toclipboard(text) end
    end)
    infoLbl.Text = ("copied %d lines"):format(#LOG)
    task.delay(2, function()
        infoLbl.Text = "watching ActivePlant..."
    end)
end
btn.MouseButton1Click:Connect(doCopy)
UserInputService.InputBegan:Connect(function(i, g)
    if not g and i.KeyCode == Enum.KeyCode.C then doCopy() end
end)

-- ─── HELPERS ───
local function dumpAttrs(obj, tag)
    local attrs = obj:GetAttributes()
    local has = false
    for _ in pairs(attrs) do has = true break end
    if not has then return end
    log(("[attr] %s %s"):format(tag, obj:GetFullName()))
    for k, v in attrs do
        log(("       %s = %s (%s)"):format(k, tostring(v), typeof(v)))
    end
end

local function dumpFullStructure(root)
    log("╔══════════════════════════════════════════")
    log(("║ STRUCTURE OF %s  [%s]"):format(root:GetFullName(), root.ClassName))
    log("╚══════════════════════════════════════════")
    dumpAttrs(root, "root")
    local function walk(o, depth)
        if depth > 5 then return end
        for _, c in o:GetChildren() do
            local indent = string.rep("  ", depth)
            local extra = ""
            if c:IsA("BasePart") then
                extra = (" size=(%.2f,%.2f,%.2f) pos=(%.1f,%.1f,%.1f) mat=%s transp=%.2f")
                    :format(c.Size.X, c.Size.Y, c.Size.Z,
                            c.Position.X, c.Position.Y, c.Position.Z,
                            tostring(c.Material), c.Transparency)
            elseif c:IsA("Model") then
                local _, s = c:GetBoundingBox()
                extra = (" bbox=(%.2f,%.2f,%.2f)"):format(s.X, s.Y, s.Z)
            elseif c:IsA("Highlight") then
                extra = (" fillcolor=%s enabled=%s"):format(
                    tostring(c.FillColor), tostring(c.Enabled))
            elseif c:IsA("BillboardGui") then
                extra = " billboard"
            elseif c:IsA("TextLabel") then
                extra = (" Text=%q"):format(c.Text)
            end
            log(("║ %s%s [%s]%s"):format(indent, c.Name, c.ClassName, extra))
            dumpAttrs(c, "  " .. c.Name)
            walk(c, depth + 1)
        end
    end
    walk(root, 0)
end

-- ─── WATCH ActivePlant ───
local lastPrimaryY = nil
local lastDumpT = 0
local structureDumped = false

task.spawn(function()
    while true do
        task.wait(0.25)
        local ap = workspace:FindFirstChild("ActivePlant")
        if ap then
            -- dump full structure once per new ActivePlant instance
            if not structureDumped then
                structureDumped = true
                dumpFullStructure(ap)
            end

            -- watch size changes on the largest part / model bbox
            local _, size
            if ap:IsA("Model") then
                _, size = ap:GetBoundingBox()
            elseif ap:IsA("BasePart") then
                size = ap.Size
            end
            if size then
                local y = size.Y
                if lastPrimaryY and math.abs(y - lastPrimaryY) > 0.01 then
                    local t = os.clock()
                    if t - lastDumpT > 0.3 then
                        lastDumpT = t
                        log(("[grow] t=%.2f  bboxY=%.3f"):format(t, y))
                    end
                end
                lastPrimaryY = y
                infoLbl.Text = ("ActivePlant bboxY=%.3f\ncopied lines: %d"):format(y, #LOG)
            end
        else
            -- ActivePlant disappeared: reset so we dump the new one on next spawn
            if structureDumped then
                log("[watch] ActivePlant removed")
                structureDumped = false
                lastPrimaryY = nil
            end
            infoLbl.Text = "waiting for ActivePlant...\ncopied lines: " .. #LOG
        end
    end
end)

workspace.ChildAdded:Connect(function(c)
    if c.Name == "ActivePlant" then
        log(("[watch] 🟢 ActivePlant appeared: %s [%s]"):format(c:GetFullName(), c.ClassName))
        structureDumped = false
        lastPrimaryY = nil
    end
end)

workspace.ChildRemoved:Connect(function(c)
    if c.Name == "ActivePlant" then
        log("[watch] 🔴 ActivePlant removed")
        structureDumped = false
        lastPrimaryY = nil
    end
end)

