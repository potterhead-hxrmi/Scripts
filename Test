-- ─────────────────────────────────────────────────────────────
-- STATS ENGINE
-- Returns both models; picks the tighter one
-- ─────────────────────────────────────────────────────────────
local function computeStats()
    -- TIME model: struck rounds only
    local tArr = {}
    for _, s in STATE.roundSamples do
        if not s.early then table.insert(tArr, s.delay) end
    end
    local function mean(a) local s=0 for _,v in a do s+=v end return #a>0 and s/#a or 0 end
    local function sd(a,m) local s=0 for _,v in a do s+=(v-m)^2 end return #a>1 and math.sqrt(s/#a) or 0 end
    local tM, tS = mean(tArr), sd(tArr, mean(tArr))

    -- ROLL model: gaps from trigger rolls → next strike
    -- Approximate: for each round, find strike time; look back at rolls
    -- We tagged "trigger" rolls in stopRound(). Compute gap = strike_time - trigger.t
    local rArr = {}
    for _, r in STATE.rolls do
        if r.trigger then
            -- gap measured to the round's strike (we know it was within ROLL_LINK_WINDOW)
            -- approximate with a per-roll timing if we have a strike nearby
            -- we stored the strike AFTER trigger; approximate using recent strike delta
            -- Simpler: record gap when strike fires (see below)
        end
    end

    return {
        tMean = tM, tSd = tS, tN = #tArr,
        mode  = (#tArr >= CONFIG.MIN_ROUNDS) and "time" or "learning",
    }
end

