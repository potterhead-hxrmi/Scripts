--==============================================================
--  ACTIVEPLANT DEEP WATCH
--  Watches Workspace.ActivePlant. Dumps:
--    - every attribute on it and its descendants
--    - any BasePart size changes (with timestamps)
--    - any new descendants that appear
--  Press C to copy the whole log.
--==============================================================

local Players           = game:GetService("Players")
local UserInputService  = game:GetService("UserInputService")
local LP = Players.LocalPlayer

local LOG = {}
local function log(s)
    print(s)
    table.insert(LOG, s)
    if #LOG > 3000 then table.remove(LOG, 1) end
end

