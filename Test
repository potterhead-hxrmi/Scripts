gui.Name = "ReflexHarvest"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = LP:WaitForChild("PlayerGui")

local panel = Instance.new("Frame")
panel.Position = UDim2.new(0, 10, 0, 10)
panel.Size = UDim2.new(0, 300, 0, 130)
