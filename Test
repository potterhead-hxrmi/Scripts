local function flashBanner(text, seconds)
    banner.Text = text
    banner.Visible = true
    local blink = 0
    local conn
    conn = RunService.RenderStepped:Connect(function(dt)
        blink += dt
        local a = math.sin(blink * 12) * 0.5 + 0.5
        banner.BackgroundTransparency = 0.15 + a * 0.45
        banner.TextTransparency = a * 0.15
    end)
    task.delay(seconds, function()
        if conn then conn:Disconnect() end
        banner.Visible = false
    end)
end

-- ─────────────────────────────────────────────────────────────
-- ROUND HANDLERS
-- ─────────────────────────────────────────────────────────────
local function startRound(src)
    STATE.roundActive  = true
    STATE.roundStartT  = now()
    STATE.strikes      = {}
    STATE.rolls        = {}
    STATE.lastStrikeT  = -math.huge
    STATE.warnedForRound = nil
    print(("[%.2f] 🟢 StartRound (%s)"):format(now(), src or "?"))
end

local function stopRound(kind, src)
    if not STATE.roundActive then return end
    local duration = now() - STATE.roundStartT
    local early = (kind ~= "dead")
    table.insert(STATE.roundSamples, { strikeDelay = duration, early = early })
    print(("[%.2f] %s (%s) — delay %.2fs")
        :format(now(), early and "✅ StopPlant" or "☠️ CollectDeadTree", src or "?", duration))
    STATE.roundActive = false
    if #STATE.roundSamples >= CONFIG.LEARNING_ROUNDS then
        STATE.learning = false
    end
end

-- ─────────────────────────────────────────────────────────────
-- HOOK KNIT REMOTEFUNCTIONS
-- ─────────────────────────────────────────────────────────────
local RF_PATH = ReplicatedStorage
    :WaitForChild("Packages")._Index["sleitnick_knit@1.6.0"]
    .knit.Services.PlantRoundService.RF

local function getRF(name)
    local ok, v = pcall(function() return RF_PATH:WaitForChild(name, 10) end)
    return ok and v or nil
end

local StartRF, StopRF, DeadRF =
    getRF(CONFIG.RF_START), getRF(CONFIG.RF_STOP), getRF(CONFIG.RF_DEAD)

local function tryHookInvoke(rf, onCall)
    if not rf then warn("[predictor] missing RF") return false end
    if type(hookfunction) ~= "function" then
        warn("[predictor] no hookfunction — RF hooks disabled") return false
    end
    local oldInvoke = rf.InvokeServer
    hookfunction(oldInvoke, function(self, ...)
        local rets = { oldInvoke(self, ...) }
        if self == rf then onCall(rets) end
        return table.unpack(rets)
    end)
    return true
end

tryHookInvoke(StartRF, function() startRound("StartRound RF") end)
tryHookInvoke(StopRF,  function() stopRound("early", "StopPlant RF") end)
tryHookInvoke(DeadRF,  function() stopRound("dead",  "CollectDeadTree RF") end)

-- ─────────────────────────────────────────────────────────────
-- LIGHTNING BOLT HOOK
-- ─────────────────────────────────────────────────────────────
do
    local ok, mod = pcall(function()
        return require(ReplicatedStorage.Shared.Utility.LightningBolt)
    end)
    if ok and type(mod) == "table" and type(mod.strike) == "function" then
        local orig = mod.strike
        mod.strike = function(a, b, opts)
            if STATE.roundActive then
                local t = now()
                if t - STATE.lastStrikeT >= CONFIG.MIN_GAP then
                    STATE.lastStrikeT = t
                    table.insert(STATE.strikes, { t = t, roundT = t - STATE.roundStartT })
                    print(("[%.2f] ⚡ bolt at round t=%.2fs"):format(t, t - STATE.roundStartT))
                end
            end
            return orig(a, b, opts)
        end
    end
end

-- ─────────────────────────────────────────────────────────────
-- ROLL HOOK
-- ─────────────────────────────────────────────────────────────
do
    local ok, RW = pcall(function()
        return require(ReplicatedStorage.Shared.Utility.RollWeighted)
    end)
    if ok and type(RW) == "table" and type(RW.Roll) == "function" then
        local origRoll = RW.Roll
        RW.Roll = function(self, tbl, dbg)
            local snap, total = {}, 0
            if type(tbl) == "table" then
                for i, e in tbl do
                    snap[i] = { weight = e.weight, name = e.name or e.kind or e.type or tostring(i) }
                    total += (e.weight or 0)
                end
            end
            local result, key = origRoll(self, tbl, dbg)
            if STATE.roundActive then
                local cw = (type(result) == "table") and result.weight or nil
                local chance = (cw and total > 0) and (cw / total * 100) or nil
                table.insert(STATE.rolls, { t = now(), key = key, chance = chance, entries = #snap })
                if CONFIG.SHOW_ROLLS then
                    print(("[%.2f] 🎲 ROLL key=%s chance=%s entries=%d")
                        :format(now(), tostring(key),
                                chance and ("%.2f%%"):format(chance) or "n/a", #snap))
                end
                if not STATE._dumpedRoll then
                    STATE._dumpedRoll = true
                    print("[predictor] first roll table:")
                    for i, e in snap do
                        print(("   [%s] name=%s weight=%s"):format(tostring(i), tostring(e.name), tostring(e.weight)))
                    end
                end
            end
            return result, key
        end
        print("[predictor] hooked RollWeighted.Roll ✔")
    end
end

-- ─────────────────────────────────────────────────────────────
-- TELEGRAPH WATCHER
-- ─────────────────────────────────────────────────────────────
do
    local C = { Highlight = true, PointLight = true, Sound = true,
                ParticleEmitter = true, BillboardGui = true }
    workspace.DescendantAdded:Connect(function(d)
        if STATE.roundActive and C[d.ClassName] then
            table.insert(STATE.telegraphs, { t = now(), kind = d.ClassName })
        end
    end)
end

-- ─────────────────────────────────────────────────────────────
-- HUD LOOP
-- ─────────────────────────────────────────────────────────────
local function avgStrike()
    local sum, n = 0, 0
    for _, s in STATE.roundSamples do
        if not s.early then sum += s.strikeDelay; n += 1 end
    end
    return (n > 0 and sum / n or 0), n
end

task.spawn(function()
    while true do
        task.wait(0.05)

        if STATE.roundActive then
            local rt = now() - STATE.roundStartT
            roundLbl.Text = ("PLANTED  +%.1fs"):format(rt)
            roundLbl.TextColor3 = Color3.fromRGB(120,220,120)

            local avg, n = avgStrike()
            if not STATE.learning and n >= 2 then
                local left = avg - rt
                countdown.Text = (left > 0)
                    and ("STRIKE ~%.1fs"):format(left)
                    or  "STRIKE imminent"
                detail.Text = ("avg %.1fs after plant (%d)"):format(avg, n)

                if left > 0 and left <= CONFIG.LEAD_TIME
                   and STATE.warnedForRound ~= STATE.roundStartT then
                    STATE.warnedForRound = STATE.roundStartT
                    flashBanner(("⚡ IN %.1fs ⚡"):format(left), 3)
                end
            else
                countdown.Text = "--"
                detail.Text = ("learning %d/%d rounds"):format(#STATE.roundSamples, CONFIG.LEARNING_ROUNDS)
            end
        else
            roundLbl.Text = "WAITING FOR PLANT"
            roundLbl.TextColor3 = Color3.fromRGB(180,140,80)
            local avg, n = avgStrike()
            countdown.Text = "--"
            detail.Text = (n > 0)
                and ("last avg %.1fs (%d)"):format(avg, n)
                or  "plant a seed to start"
        end

        if #STATE.rolls > 0 then
            local lr = STATE.rolls[#STATE.rolls]
            rollLbl.Text = ("🎲 %s  %s  (%d rolls)")
                :format(tostring(lr.key),
                        lr.chance and ("%.1f%%"):format(lr.chance) or "n/a",
                        #STATE.rolls)
        else
            rollLbl.Text = "🎲 no rolls yet"
        end
    end
end)

print("[predictor] v5 loaded — compact + draggable.")
