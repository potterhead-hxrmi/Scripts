-- ─────────────────────────────────────────────────────────────
-- ALERT + BANNER ANIMATION
-- ─────────────────────────────────────────────────────────────
local function flashBanner(text, seconds)
    banner.Text = text
    banner.Visible = true
    local blink = 0
    local conn
    conn = RunService.RenderStepped:Connect(function(dt)
        blink += dt
        local a = (math.sin(blink * 12) * 0.5 + 0.5)
        banner.BackgroundTransparency = 0.15 + a * 0.45
        banner.TextTransparency    = a * 0.15
    end)
    task.delay(seconds, function()
        if conn then conn:Disconnect() end
        banner.Visible = false
    end)
end

-- ─────────────────────────────────────────────────────────────
-- LAYER 3: hook strike (safety net + learning)
-- ─────────────────────────────────────────────────────────────
do
    local ok, mod = pcall(function()
        return require(ReplicatedStorage.Shared.Utility.LightningBolt)
    end)
    if ok and type(mod) == "table" and type(mod.strike) == "function" then
        local orig = mod.strike
        mod.strike = function(a, b, opts)
            local t = now()
            if t - STATE.lastStrikeT >= CONFIG.MIN_GAP then
                STATE.lastStrikeT = t
                table.insert(STATE.strikes, { t = t })
                if STATE.learning and #STATE.strikes >= CONFIG.LEARNING_STRIKES then
                    STATE.learning = false
                end
            end
            return orig(a, b, opts)
        end
    end
end

-- ─────────────────────────────────────────────────────────────
-- LAYER 1: telegraph watcher
-- ─────────────────────────────────────────────────────────────
do
    local CLASSES = {
        Highlight = true, PointLight = true, Sound = true,
        ParticleEmitter = true, BillboardGui = true,
    }
    workspace.DescendantAdded:Connect(function(d)
        if CLASSES[d.ClassName] then
            table.insert(STATE.telegraphs, { t = now(), kind = d.ClassName })
        end
    end)
end

-- ─────────────────────────────────────────────────────────────
-- PREDICTION / HUD LOOP
-- ─────────────────────────────────────────────────────────────
task.spawn(function()
    while true do
        task.wait(0.05)

        -- update status line
        status.Text = STATE.learning
            and ("Learning… %d/%d strikes"):format(#STATE.strikes, CONFIG.LEARNING_STRIKES)
            or  ("Predicting  •  %d strikes seen"):format(#STATE.strikes)

        if not STATE.learning and #STATE.strikes >= 2 then
            -- average interval from last few strikes
            local n = math.min(#STATE.strikes, 6)
            local sum, cnt = 0, 0
            for i = #STATE.strikes - n + 1, #STATE.strikes - 1 do
                if STATE.strikes[i] and STATE.strikes[i + 1] then
                    sum += STATE.strikes[i + 1].t - STATE.strikes[i].t
                    cnt += 1
                end
            end
            if cnt > 0 then
                local avg = sum / cnt
                local last = STATE.strikes[#STATE.strikes].t
                local nextT = last + avg
                local left = nextT - now()

                countdown.Text = (left > 0)
                    and ("NEXT: ~%.1fs"):format(left)
                    or  "NEXT: imminent"

                detail.Text = ("avg interval %.1fs  •  %d strikes")
                    :format(avg, #STATE.strikes)

                if left > 0 and left <= CONFIG.LEAD_TIME and STATE.warnedFor ~= last then
                    STATE.warnedFor = last
                    flashBanner(("⚡ LIGHTNING IN %.1fs ⚡"):format(left), 3)
                end
            end
        elseif STATE.learning then
            countdown.Text = "--"
            detail.Text = "waiting for enough strikes…"
        end
    end
end)

print("[predictor] HUD loaded.")
