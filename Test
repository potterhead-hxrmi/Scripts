--==============================================================
--  STARTROUND RESPONSE TESTER
--  Logs: args sent to StartRound + server return value
--        + Cost label trail during the round
--==============================================================

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LP = Players.LocalPlayer
local T0 = os.clock()

local RF_PATH = ReplicatedStorage
    :WaitForChild("Packages")._Index["sleitnick_knit@1.6.0"]
    .knit.Services.PlantRoundService.RF

local function getRF(n)
    local ok, v = pcall(function() return RF_PATH:WaitForChild(n, 10) end)
    return ok and v or nil
end
local StartRF = getRF("StartRound")
local StopRF  = getRF("StopPlant")
local DeadRF  = getRF("CollectDeadTree")

local function now() return os.clock() - T0 end

local STATE = {
    roundActive = false,
    roundStartT = 0,
    samples     = {},
}

-- ─────────────────────────────────────────────────────────────
-- HUD
-- ─────────────────────────────────────────────────────────────
local gui = Instance.new("ScreenGui")
gui.Name = "StartRoundTester"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = LP:WaitForChild("PlayerGui")

local panel = Instance.new("Frame")
panel.Position = UDim2.new(0, 10, 0, 10)
panel.Size = UDim2.new(0, 300, 0, 120)
panel.BackgroundColor3 = Color3.fromRGB(15,15,20)
panel.BackgroundTransparency = 0.15
panel.BorderSizePixel = 0
panel.Active = true; panel.Draggable = true
panel.Parent = gui
Instance.new("UICorner", panel).CornerRadius = UDim.new(0, 8)

local function mk(n,y,h,f,s,c)
    local l = Instance.new("TextLabel")
    l.Name = n; l.BackgroundTransparency = 1
    l.Position = UDim2.new(0,8,0,y); l.Size = UDim2.new(1,-16,0,h)
    l.Font = f; l.TextSize = s; l.TextColor3 = c
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.TextYAlignment = Enum.TextYAlignment.Top
    l.TextWrapped = true; l.Parent = panel; return l
end
local title  = mk("T",4,14,Enum.Font.GothamBold,12,Color3.fromRGB(200,220,255))
title.Text   = "🎯 STARTROUND RESPONSE"
local retLbl = mk("Ret",20,30,Enum.Font.Code,10,Color3.fromRGB(255,220,140))
retLbl.Text  = "ret: --"
local costLbl= mk("Cost",52,16,Enum.Font.Code,11,Color3.fromRGB(150,220,150))
costLbl.Text = "cost: --"
local timeLbl= mk("Time",70,16,Enum.Font.Code,10,Color3.fromRGB(160,160,180))
timeLbl.Text = "t: --"
local infoLbl= mk("Info",88,24,Enum.Font.Code,10,Color3.fromRGB(160,160,180))
infoLbl.Text = "plant a seed"

-- ─────────────────────────────────────────────────────────────
-- HELPERS
-- ─────────────────────────────────────────────────────────────
local function readCost()
    for _, d in workspace:GetDescendants() do
        if d.Name == "FruitDisplay" then
            local bb = d:FindFirstChildWhichIsA("BillboardGui", true)
            local fr = bb and bb:FindFirstChild("Frame")
            local cost = fr and fr:FindFirstChild("Cost")
            if cost and cost:IsA("TextLabel") then return cost.Text end
        end
    end
    return nil
end

local function formatRets(rets)
    if type(rets) ~= "table" then return tostring(rets) end
    local out = {}
    for i, v in rets do
        table.insert(out, ("[%d]=%s"):format(i, tostring(v)))
    end
    return table.concat(out, "  ")
end

-- ─────────────────────────────────────────────────────────────
-- RF HOOK
-- ─────────────────────────────────────────────────────────────
do
    local mt = getrawmetatable(game)
    if mt then
        local old = mt.__namecall
        setreadonly(mt, false)
        mt.__namecall = newcclosure(function(self, ...)
            local m = getnamecallmethod()
            if m == "InvokeServer"
            and (self == StartRF or self == StopRF or self == DeadRF) then
                local args = { ... }
                local rets = { old(self, ...) }

                if self == StartRF then
                    STATE.roundActive = true
                    STATE.roundStartT = now()
                    STATE.samples = {}

                    print("═══════════════════════════════════════════════")
                    print(("[%.2f] 🟢 StartRound CALLED"):format(now()))
                    print("   args sent:")
                    for i, a in args do
                        print(("     [%d] %s (%s)"):format(i, tostring(a), typeof(a)))
                    end
                    print("   return value from server:")
                    if #rets == 0 then
                        print("     (no return value)")
                    else
                        for i, r in rets do
                            print(("     [%d] %s (%s)"):format(i, tostring(r), typeof(r)))
                            if type(r) == "table" then
                                for k, v in pairs(r) do
                                    print(("        .%s = %s (%s)"):format(tostring(k), tostring(v), typeof(v)))
                                end
                            end
                        end
                    end
                    print("═══════════════════════════════════════════════")

                    retLbl.Text = "ret: " .. formatRets(rets)
                elseif self == StopRF then
                    print(("[%.2f] ✅ StopPlant (early)"):format(now()))
                    STATE.roundActive = false
                elseif self == DeadRF then
                    print(("[%.2f] ☠️ CollectDeadTree (struck) — round %.2fs")
                        :format(now(), now() - STATE.roundStartT))
                    print("   full cost trail:")
                    for i, s in STATE.samples do
                        print(("     t=%.2f  cost=%s"):format(s.t, s.cost))
                    end
                    STATE.roundActive = false
                end
                return table.unpack(rets)
            end
            return old(self, ...)
        end)
        setreadonly(mt, true)
        print("[tester] __namecall ✔")
    end
end

-- ─────────────────────────────────────────────────────────────
-- COST SAMPLER
-- ─────────────────────────────────────────────────────────────
task.spawn(function()
    while true do
        task.wait(0.25)
        if STATE.roundActive then
            local c = readCost()
            if c then
                table.insert(STATE.samples, { t = now() - STATE.roundStartT, cost = c })
                while #STATE.samples > 2000 do table.remove(STATE.samples, 1) end
                costLbl.Text = "cost: " .. c
                timeLbl.Text = ("t: %.2fs  samples: %d")
                    :format(now() - STATE.roundStartT, #STATE.samples)
            else
                costLbl.Text = "cost: (none yet)"
            end
        else
            costLbl.Text = "cost: --"
            timeLbl.Text = "t: --"
        end
    end
end)

print("[tester] loaded. Plant a seed and watch the console.")
print("[tester] The important line is 'return value from server:' right after StartRound.")
