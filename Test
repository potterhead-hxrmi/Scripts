-- ─────────────────────────────────────────────────────────────
-- ROUND HANDLERS
-- ─────────────────────────────────────────────────────────────
local function startRound(seed, fert)
    STATE.roundActive    = true
    STATE.roundStartT    = now()
    STATE.roundSeed      = seed or "?"
    STATE.roundFert      = fert or "?"
    STATE.lastStrikeT    = -math.huge
    STATE.warnedForRound = nil
    STATE.currentValue   = nil
    STATE.rolls          = {}   -- fresh roll window each round
    print(("[%.2f] 🟢 StartRound  seed=%s  fert=%s"):format(now(), STATE.roundSeed, STATE.roundFert))
end

local function stopRound(kind)
    if not STATE.roundActive then return end
    local delay = now() - STATE.roundStartT
    local early = (kind ~= "dead")

    -- tag the last roll(s) as trigger if within window
    if not early then
        for i = #STATE.rolls, 1, -1 do
            local r = STATE.rolls[i]
            if (now() - r.t) <= CONFIG.ROLL_LINK_WINDOW then
                r.trigger = true
            else
                break
            end
        end
    end

    table.insert(STATE.roundSamples, {
        delay = delay, early = early,
        value = STATE.currentValue,
        seed  = STATE.roundSeed, fert = STATE.roundFert,
    })

    print(("[%.2f] %s — delay %.2fs  value=%s")
        :format(now(), early and "✅ StopPlant" or "☠️ CollectDeadTree",
                delay, tostring(STATE.currentValue)))

    STATE.roundActive = false
end

-- ─────────────────────────────────────────────────────────────
-- RF HOOK via __namecall
-- ─────────────────────────────────────────────────────────────
local RF_PATH = ReplicatedStorage
    :WaitForChild("Packages")._Index["sleitnick_knit@1.6.0"]
    .knit.Services.PlantRoundService.RF

local function getRF(name)
    local ok, v = pcall(function() return RF_PATH:WaitForChild(name, 10) end)
    return ok and v or nil
end

local StartRF, StopRF, DeadRF =
    getRF(CONFIG.RF_START), getRF(CONFIG.RF_STOP), getRF(CONFIG.RF_DEAD)

do
    local mt = getrawmetatable(game)
    if mt then
        local old = mt.__namecall
        setreadonly(mt, false)
        mt.__namecall = newcclosure(function(self, ...)
            local m = getnamecallmethod()
            if m == "InvokeServer"
            and (self == StartRF or self == StopRF or self == DeadRF) then
                local args = { ... }
                local rets = { old(self, ...) }
                if self == StartRF then startRound(args[1], args[2])
                elseif self == StopRF then stopRound("early")
                elseif self == DeadRF then stopRound("dead")
                end
                return table.unpack(rets)
            end
            return old(self, ...)
        end)
        setreadonly(mt, true)
        print("[predictor] __namecall hook installed ✔")
    else
        warn("[predictor] no metatable — RF hooks disabled")
    end
end

-- ─────────────────────────────────────────────────────────────
-- LIGHTNING BOLT HOOK
-- ─────────────────────────────────────────────────────────────
do
    local ok, mod = pcall(function()
        return require(ReplicatedStorage.Shared.Utility.LightningBolt)
    end)
    if ok and type(mod) == "table" and type(mod.strike) == "function" then
        local orig = mod.strike
        mod.strike = function(a, b, opts)
            if STATE.roundActive then
                local t = now()
                if t - STATE.lastStrikeT >= CONFIG.MIN_STRIKE_GAP then
                    STATE.lastStrikeT = t
                    print(("[%.2f] ⚡ bolt at round t=%.2fs"):format(t, t - STATE.roundStartT))
                end
            end
            return orig(a, b, opts)
        end
    end
end

-- ─────────────────────────────────────────────────────────────
-- ROLL HOOK
-- ─────────────────────────────────────────────────────────────
do
    local ok, RW = pcall(function()
        return require(ReplicatedStorage.Shared.Utility.RollWeighted)
    end)
    if ok and type(RW) == "table" and type(RW.Roll) == "function" then
        local orig = RW.Roll
        RW.Roll = function(self, tbl, dbg)
            local snap, total = {}, 0
            if type(tbl) == "table" then
                for i, e in tbl do
                    snap[i] = { weight = e.weight,
                                name = e.name or e.kind or e.type or tostring(i) }
                    total += (e.weight or 0)
                end
            end
            local result, key = orig(self, tbl, dbg)

            if STATE.roundActive then
                local cw = (type(result) == "table") and result.weight or nil
                local chance = (cw and total > 0) and (cw / total * 100) or nil
                table.insert(STATE.rolls, {
                    t = now(), key = key, weight = cw,
                    total = total, chance = chance, entries = #snap,
                })
                -- keep only recent rolls
                while #STATE.rolls > 200 do table.remove(STATE.rolls, 1) end

                if CONFIG.SHOW_LOGS then
                    print(("[%.2f] 🎲 ROLL key=%s chance=%s entries=%d")
                        :format(now(), tostring(key),
                                chance and ("%.2f%%"):format(chance) or "n/a", #snap))
                end
                if not STATE._dumpedRoll then
                    STATE._dumpedRoll = true
                    print("[predictor] first roll table:")
                    for i, e in snap do
                        print(("   [%s] name=%s weight=%s"):format(
                            tostring(i), tostring(e.name), tostring(e.weight)))
                    end
                end
            end
            return result, key
        end
        print("[predictor] RollWeighted hooked ✔")
    end
end

