--==============================================================
--  ATTRIBUTE DUMPER
--  During a round, dumps every attribute on:
--    - the growing tree model
--    - the plot model (ancestor of the tree)
--    - the fruit spawn folder
--  Press C to copy everything to clipboard.
--==============================================================

local Players           = game:GetService("Players")
local UserInputService  = game:GetService("UserInputService")
local LP = Players.LocalPlayer

local LOG = {}
local function log(s)
    print(s)
    table.insert(LOG, s)
end

local gui = Instance.new("ScreenGui")
gui.Name = "AttrDump"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = LP:WaitForChild("PlayerGui")
local panel = Instance.new("Frame")
panel.Position = UDim2.new(0, 10, 0, 10)
panel.Size = UDim2.new(0, 280, 0, 80)
panel.BackgroundColor3 = Color3.fromRGB(15,15,20)
panel.BackgroundTransparency = 0.15
panel.BorderSizePixel = 0
panel.Active = true; panel.Draggable = true
panel.Parent = gui
Instance.new("UICorner", panel).CornerRadius = UDim.new(0, 8)

local btn = Instance.new("TextButton")
btn.Position = UDim2.new(0, 8, 1, -30)
btn.Size = UDim2.new(1, -16, 0, 24)
btn.BackgroundColor3 = Color3.fromRGB(50, 90, 140)
btn.Font = Enum.Font.GothamBold
btn.TextSize = 12
btn.TextColor3 = Color3.fromRGB(230, 240, 255)
btn.Text = "📋 COPY  (C)"
btn.BorderSizePixel = 0
btn.Parent = panel
Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

local infoLbl = Instance.new("TextLabel")
infoLbl.BackgroundTransparency = 1
infoLbl.Position = UDim2.new(0, 8, 0, 4)
infoLbl.Size = UDim2.new(1, -16, 0, 44)
infoLbl.Font = Enum.Font.Code
infoLbl.TextSize = 10
infoLbl.TextColor3 = Color3.fromRGB(200, 220, 200)
infoLbl.TextXAlignment = Enum.TextXAlignment.Left
infoLbl.TextYAlignment = Enum.TextYAlignment.Top
infoLbl.TextWrapped = true
infoLbl.Text = "watching..."
infoLbl.Parent = panel

local function doCopy()
    local text = table.concat(LOG, "\n")
    pcall(function()
        if setclipboard then setclipboard(text)
        elseif toclipboard then toclipboard(text) end
    end)
    infoLbl.Text = ("copied %d lines"):format(#LOG)
end
btn.MouseButton1Click:Connect(doCopy)
UserInputService.InputBegan:Connect(function(i, g)
    if not g and i.KeyCode == Enum.KeyCode.C then doCopy() end
end)

-- find the tree near the player
local function findTree()
    local best, bestVol
    for _, d in workspace:GetChildren() do
        if d:IsA("Model") and d.Name ~= "TreeGhost" then
            if d.Name:lower():find("tree") or d:FindFirstChild("FruitSpawns") then
                local _, size = d:GetBoundingBox()
                local vol = size.X * size.Y * size.Z
                if vol > 0 and (not bestVol or vol > bestVol) then
                    best, bestVol = d, vol
                end
            end
        end
    end
    return best
end

-- walk up the tree's ancestors to find the plot model
local function plotOf(tree)
    if not tree then return nil end
    local cur = tree.Parent
    for _ = 1, 6 do
        if not cur or cur == workspace then return nil end
        if cur:IsA("Model") and cur:FindFirstChild("FruitSpawns") then return cur end
        cur = cur.Parent
    end
    return nil
end

local dumpedTrees = {}

local function dumpAttrs(obj, label)
    if not obj then return end
    local attrs = obj:GetAttributes()
    local count = 0
    for k, v in attrs do count = count + 1 end
    if count == 0 then return end
    log(("[attrs] %s  (%s)"):format(label, obj:GetFullName()))
    for k, v in attrs do
        log(("        %s = %s (%s)"):format(k, tostring(v), typeof(v)))
    end
end

task.spawn(function()
    while true do
        task.wait(1)
        local tree = findTree()
        if tree and not dumpedTrees[tree] then
            dumpedTrees[tree] = true
            log("════════════════════════════════════════")
            log(("[dump] NEW TREE: %s"):format(tree:GetFullName()))
            dumpAttrs(tree, "tree")
            local plot = plotOf(tree)
            if plot then
                dumpAttrs(plot, "plot")
                -- also dump the plot's parent (usually a folder of plots)
                if plot.Parent and plot.Parent ~= workspace then
                    dumpAttrs(plot.Parent, "plot.parent")
                end
            end
            -- also dump the fruit spawns folder
            local fs = tree:FindFirstChild("FruitSpawns")
            if fs then dumpAttrs(fs, "FruitSpawns") end
            infoLbl.Text = ("dumped tree at %.1fs"):format(os.clock())
        end
    end
end)

log("[attr-dump] loaded.")
log("[attr-dump] plant a seed — attributes will print when a new tree appears.")
log("[attr-dump] press C to copy everything.")
