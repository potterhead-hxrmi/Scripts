local CONFIG = {
    LEAD_TIME        = 3.0,
    LEARNING_ROUNDS  = 4,     -- rounds needed before predicting
    MIN_GAP          = 1.0,
    SHOW_ROLLS       = true,
    RF_START  = "StartRound",
    RF_STOP   = "StopPlant",
    RF_DEAD   = "CollectDeadTree",
}

local STATE = {
    roundActive   = false,
    roundStartT   = 0,
    roundSamples  = {},   -- { strikeDelay = n, stoppedEarly = bool }
    strikes       = {},   -- in-round bolt strikes
    rolls         = {},
    telegraphs    = {},
    learning      = true,
    lastStrikeT   = -math.huge,
    warnedForRound = nil,
    _dumpedRoll   = false,
}

local function now() return os.clock() - T0 end

