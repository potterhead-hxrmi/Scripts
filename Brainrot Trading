-- ============================================================
-- Reveal Values toggle
-- ============================================================
local _vtOn = false
local _vtOriginals = {}
local _vtConn = nil

local function _vtFind()
	local Workspace = game:GetService("Workspace")
	local found, seen = {}, {}
	local function add(l)
		if l and not seen[l] then seen[l] = true; table.insert(found, l) end
	end
	local tf = Workspace:FindFirstChild("TradesFolder")
	if tf then
		for _, tp in ipairs(tf:GetChildren()) do
			local touch = tp:FindFirstChild("Touch")
			if touch then
				local gui = touch:FindFirstChild("Players")
				if gui and gui:IsA("BillboardGui") then
					for _, d in ipairs(gui:GetDescendants()) do
						if d:IsA("TextLabel") and d.Name == "Value" then add(d) end
					end
				end
			end
		end
	end
	for _, d in ipairs(Workspace:GetDescendants()) do
		if d:IsA("TextLabel") and d.Name == "Value" then add(d) end
	end
	return found
end

Tab:CreateToggle({
	Name = "Reveal Values",
	CurrentValue = false,
	Flag = "RevealValues",
	Callback = function(Value)
		if Value then
			_vtOn = true
			if _vtConn then _vtConn:Disconnect() end
			_vtConn = game:GetService("RunService").RenderStepped:Connect(function()
				if not _vtOn then return end
				for _, l in ipairs(_vtFind()) do
					if _vtOriginals[l] == nil then _vtOriginals[l] = l.Visible end
					if not l.Visible then l.Visible = true end
				end
			end)
		else
			_vtOn = false
			if _vtConn then _vtConn:Disconnect(); _vtConn = nil end
			for l, v in pairs(_vtOriginals) do
				pcall(function() l.Visible = v end)
			end
			_vtOriginals = {}
		end
	end,
})

-- ============================================================
-- Trade Scam (Hitbox Swap) — logic
-- ============================================================
local Players    = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace  = game:GetService("Workspace")
local UIS        = game:GetService("UserInputService")

local player = Players.LocalPlayer

-- Finders
local function getClosestTradePlace(pos)
	local folder = Workspace:FindFirstChild("TradesFolder")
	if not folder then return nil end
	local closest, bestDist = nil, math.huge
	for _, tp in ipairs(folder:GetChildren()) do
		if tp:IsA("Model") then
			local ref = tp.PrimaryPart or tp:FindFirstChild("Touch")
				or tp:FindFirstChildWhichIsA("BasePart")
			if ref then
				local d = (ref.Position - pos).Magnitude
				if d < bestDist then bestDist = d; closest = tp end
			end
		end
	end
	return closest
end

-- Figure out which side (1 or 2) you're on by comparing
-- the distance from your HRP to CorrectGroup1 vs CorrectGroup2
local function getMySide(tradePlace, pos)
	local cg1 = tradePlace:FindFirstChild("CorrectGroup1")
	local cg2 = tradePlace:FindFirstChild("CorrectGroup2")
	if not cg1 or not cg2 then return nil end

	local hb1 = cg1:FindFirstChild("Hitbox")
	local hb2 = cg2:FindFirstChild("Hitbox")
	if not hb1 or not hb2 then return nil end

	local d1 = (hb1.Position - pos).Magnitude
	local d2 = (hb2.Position - pos).Magnitude

	return d1 <= d2 and 1 or 2
end

-- Swap state
local swapOn = false
local swapConn = nil
local activeSwaps = {}      -- currently swapped hitboxes
local currentSideKey = nil  -- "TradePlaceName:side" to detect side changes

local function restoreAll()
	for _, entry in ipairs(activeSwaps) do
		pcall(function() entry.hitbox.CFrame = entry.original end)
	end
	activeSwaps = {}
	currentSideKey = nil
end

local function ensureTracked(hb)
	for _, e in ipairs(activeSwaps) do
		if e.hitbox == hb then return end
	end
	table.insert(activeSwaps, { hitbox = hb, original = hb.CFrame })
end

local function tickSwap()
	local char = player.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	local tp = getClosestTradePlace(hrp.Position)
	if not tp then
		-- No trade place nearby — release anything we had
		if currentSideKey then restoreAll() end
		return
	end

	local side = getMySide(tp, hrp.Position)
	if not side then return end

	local key = tp.Name .. ":" .. tostring(side)

	-- If side changed (walked to other slot, or different TradePlace),
	-- restore the previous hitboxes before swapping the new side
	if currentSideKey ~= key then
		restoreAll()
		currentSideKey = key
	end

	local correctGrp = tp:FindFirstChild("CorrectGroup" .. side)
	local wrongGrp   = tp:FindFirstChild("WrongeGroup" .. side)
	if not correctGrp or not wrongGrp then return end

	local correctHb = correctGrp:FindFirstChild("Hitbox")
	local wrongHb   = wrongGrp:FindFirstChild("Hitbox")
	if not correctHb or not wrongHb then return end

	ensureTracked(correctHb)
	ensureTracked(wrongHb)

	local target = hrp.CFrame
	correctHb.CFrame = target - Vector3.new(0, 10, 0)
	wrongHb.CFrame   = target
end

local function startSwap()
	if swapConn then swapConn:Disconnect() end
	swapOn = true
	swapConn = RunService.RenderStepped:Connect(function()
		if swapOn then tickSwap() end
	end)
end

local function stopSwap()
	swapOn = false
	if swapConn then swapConn:Disconnect(); swapConn = nil end
	restoreAll()
end

