local function fireRoll()
	local machine = Workspace:FindFirstChild("RNGMachine")
	if not machine then return end
	local promptHolder = machine:FindFirstChild("Prompt")
	if not promptHolder then return end
	local prompt = promptHolder:FindFirstChild("RNGMachinePrompt")
	if not prompt then return end
	pcall(function() fireproximityprompt(prompt) end)
end

local function isSelected(name)
	for _, n in ipairs(_arSelected) do
		if n == name then return true end
	end
	return false
end

local function getHeldMatch()
	if #_arSelected == 0 then return nil end
	local splitFolder = Workspace:FindFirstChild("HahaDoASplit")
	if not splitFolder then return nil end
	for _, tool in ipairs(splitFolder:GetChildren()) do
		if tool:IsA("Tool") and isSelected(tool.Name) then
			return tool
		end
	end
	return nil
end

local function sellTool(toolName)
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	if not remotes then return end
	local remote = remotes:FindFirstChild("SellAndDrop")
	if not remote then return end
	pcall(function()
		remote:FireServer("Sell", {
			Price = 100,
			Name = toolName,
		})
	end)
end

local function autoRollLoop()
	while _arRolling do
		fireRoll()
		local match = getHeldMatch()
		if match then
			sellTool(match.Name)
		end
		task.wait(0.1)
	end
end

local function startAutoRoll()
	if _arThread then return end
	_arRolling = true
	_arThread = task.spawn(autoRollLoop)
end

local function stopAutoRoll()
	_arRolling = false
	_arThread = nil
end

