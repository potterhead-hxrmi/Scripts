local Players    = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace  = game:GetService("Workspace")
local UIS        = game:GetService("UserInputService")

local player = Players.LocalPlayer

local function getClosestTradePlace(pos)
	local folder = Workspace:FindFirstChild("TradesFolder")
	if not folder then return nil end
	local closest, bestDist = nil, math.huge
	for _, tp in ipairs(folder:GetChildren()) do
		if tp:IsA("Model") then
			local ref = tp.PrimaryPart or tp:FindFirstChild("Touch")
				or tp:FindFirstChildWhichIsA("BasePart")
			if ref then
				local d = (ref.Position - pos).Magnitude
				if d < bestDist then bestDist = d; closest = tp end
			end
		end
	end
	return closest
end

local function getMySide(tradePlace, pos)
	local cg1 = tradePlace:FindFirstChild("CorrectGroup1")
	local cg2 = tradePlace:FindFirstChild("CorrectGroup2")
	if not cg1 or not cg2 then return nil end
	local hb1 = cg1:FindFirstChild("Hitbox")
	local hb2 = cg2:FindFirstChild("Hitbox")
	if not hb1 or not hb2 then return nil end
	local d1 = (hb1.Position - pos).Magnitude
	local d2 = (hb2.Position - pos).Magnitude
	return d1 <= d2 and 1 or 2
end

local swapOn = false
local swapConn = nil
local activeSwaps = {}
local currentSideKey = nil

local function restoreAll()
	for _, entry in ipairs(activeSwaps) do
		pcall(function() entry.hitbox.CFrame = entry.original end)
	end
	activeSwaps = {}
	currentSideKey = nil
end

local function ensureTracked(hb)
	for _, e in ipairs(activeSwaps) do
		if e.hitbox == hb then return end
	end
	table.insert(activeSwaps, { hitbox = hb, original = hb.CFrame })
end

local function tickSwap()
	local char = player.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	local tp = getClosestTradePlace(hrp.Position)
	if not tp then
		if currentSideKey then restoreAll() end
		return
	end

	local side = getMySide(tp, hrp.Position)
	if not side then return end

	local key = tp.Name .. ":" .. tostring(side)
	if currentSideKey ~= key then
		restoreAll()
		currentSideKey = key
	end

	local correctGrp = tp:FindFirstChild("CorrectGroup" .. side)
	local wrongGrp   = tp:FindFirstChild("WrongeGroup" .. side)
	if not correctGrp or not wrongGrp then return end

	local correctHb = correctGrp:FindFirstChild("Hitbox")
	local wrongHb   = wrongGrp:FindFirstChild("Hitbox")
	if not correctHb or not wrongHb then return end

	ensureTracked(correctHb)
	ensureTracked(wrongHb)

	local target = hrp.CFrame
	correctHb.CFrame = target - Vector3.new(0, 10, 0)
	wrongHb.CFrame   = target
end

local function startSwap()
	if swapConn then swapConn:Disconnect() end
	swapOn = true
	swapConn = RunService.RenderStepped:Connect(function()
		if swapOn then tickSwap() end
	end)
end

local function stopSwap()
	swapOn = false
	if swapConn then swapConn:Disconnect(); swapConn = nil end
	restoreAll()
end

