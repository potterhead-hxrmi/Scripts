-- ============================================================
-- Reveal Values toggle (instant, no lag)
-- ============================================================
local _vtOn = false
local _vtOriginals = {}
local _vtConnections = {}
local _vtScanner = nil

local function _vtHook(label)
	if _vtConnections[label] then return end
	if _vtOriginals[label] == nil then _vtOriginals[label] = label.Visible end
	if not label.Visible then label.Visible = true end
	_vtConnections[label] = label:GetPropertyChangedSignal("Visible"):Connect(function()
		if _vtOn and not label.Visible then label.Visible = true end
	end)
end

local function _vtFind()
	local Workspace = game:GetService("Workspace")
	local tf = Workspace:FindFirstChild("TradesFolder")
	if not tf then return {} end
	local found = {}
	for _, tp in ipairs(tf:GetChildren()) do
		local touch = tp:FindFirstChild("Touch")
		if touch then
			local gui = touch:FindFirstChild("Players")
			if gui and gui:IsA("BillboardGui") then
				for _, d in ipairs(gui:GetDescendants()) do
					if d:IsA("TextLabel") and d.Name == "Value" then
						table.insert(found, d)
					end
				end
			end
		end
	end
	return found
end

Tab:CreateToggle({
	Name = "Reveal Values",
	CurrentValue = false,
	Flag = "RevealValues",
	Callback = function(Value)
		if Value then
			_vtOn = true
			_vtOriginals = {}
			_vtConnections = {}
			for _, l in ipairs(_vtFind()) do _vtHook(l) end
			_vtScanner = task.spawn(function()
				while _vtOn do
					task.wait(0.5)
					if not _vtOn then break end
					for _, l in ipairs(_vtFind()) do
						if not _vtConnections[l] then _vtHook(l) end
					end
				end
			end)
		else
			_vtOn = false
			_vtScanner = nil
			for _, conn in pairs(_vtConnections) do
				pcall(function() conn:Disconnect() end)
			end
			_vtConnections = {}
			for l, v in pairs(_vtOriginals) do
				pcall(function() l.Visible = v end)
			end
			_vtOriginals = {}
		end
	end,
})

