-- ============================================================
-- Finders
-- ============================================================
local function getClosestTradePlace(pos)
	local folder = Workspace:FindFirstChild("TradesFolder")
	if not folder then return nil end
	local closest, bestDist = nil, math.huge
	for _, tp in ipairs(folder:GetChildren()) do
		if tp:IsA("Model") then
			local ref = tp.PrimaryPart or tp:FindFirstChild("Touch")
				or tp:FindFirstChildWhichIsA("BasePart")
			if ref then
				local d = (ref.Position - pos).Magnitude
				if d < bestDist then bestDist = d; closest = tp end
			end
		end
	end
	return closest
end

local function getClosestGroup(tradePlace, baseName, pos)
	local closest, bestDist = nil, math.huge
	for i = 1, 2 do
		local grp = tradePlace:FindFirstChild(baseName .. i)
		if grp then
			local hb = grp:FindFirstChild("Hitbox")
			if hb then
				local d = (hb.Position - pos).Magnitude
				if d < bestDist then
					bestDist = d
					closest = { model = grp, hitbox = hb }
				end
			end
		end
	end
	return closest
end

-- ============================================================
-- Swap state
-- ============================================================
local swapOn = false
local swapConn = nil
local activeSwaps = {}

local function restoreAll()
	for _, entry in ipairs(activeSwaps) do
		pcall(function() entry.hitbox.CFrame = entry.original end)
	end
	activeSwaps = {}
end

local function tickSwap()
	local char = player.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	local tp = getClosestTradePlace(hrp.Position)
	if not tp then return end

	local correct = getClosestGroup(tp, "CorrectGroup", hrp.Position)
	local wrong   = getClosestGroup(tp, "WrongeGroup", hrp.Position)
	if not correct or not wrong then return end

	local function ensureTracked(hb)
		for _, e in ipairs(activeSwaps) do
			if e.hitbox == hb then return end
		end
		table.insert(activeSwaps, { hitbox = hb, original = hb.CFrame })
	end

	ensureTracked(correct.hitbox)
	ensureTracked(wrong.hitbox)

	local target = hrp.CFrame
	correct.hitbox.CFrame = target - Vector3.new(0, 10, 0)
	wrong.hitbox.CFrame   = target
end

local function startSwap()
	if swapConn then swapConn:Disconnect() end
	swapOn = true
	swapConn = RunService.RenderStepped:Connect(function()
		if swapOn then tickSwap() end
	end)
end

local function stopSwap()
	swapOn = false
	if swapConn then swapConn:Disconnect(); swapConn = nil end
	restoreAll()
end

