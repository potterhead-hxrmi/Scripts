-- State kept outside so it survives across clicks
local _vtOn = false
local _vtOriginals = {}
local _vtConn = nil

local function _vtFind()
	local Workspace = game:GetService("Workspace")
	local found, seen = {}, {}
	local function add(l)
		if l and not seen[l] then seen[l] = true; table.insert(found, l) end
	end
	local tf = Workspace:FindFirstChild("TradesFolder")
	if tf then
		for _, tp in ipairs(tf:GetChildren()) do
			local touch = tp:FindFirstChild("Touch")
			if touch then
				local gui = touch:FindFirstChild("Players")
				if gui and gui:IsA("BillboardGui") then
					for _, d in ipairs(gui:GetDescendants()) do
						if d:IsA("TextLabel") and d.Name == "Value" then add(d) end
					end
				end
			end
		end
	end
	for _, d in ipairs(Workspace:GetDescendants()) do
		if d:IsA("TextLabel") and d.Name == "Value" then add(d) end
	end
	return found
end

Tab:CreateToggle({
	Name = "Reveal Values",
	CurrentValue = false,
	Flag = "RevealValues",
	Callback = function(Value)
		if Value then
			_vtOn = true
			if _vtConn then _vtConn:Disconnect() end
			_vtConn = game:GetService("RunService").RenderStepped:Connect(function()
				if not _vtOn then return end
				for _, l in ipairs(_vtFind()) do
					if _vtOriginals[l] == nil then _vtOriginals[l] = l.Visible end
					if not l.Visible then l.Visible = true end
				end
			end)
		else
			_vtOn = false
			if _vtConn then _vtConn:Disconnect(); _vtConn = nil end
			for l, v in pairs(_vtOriginals) do
				pcall(function() l.Visible = v end)
			end
			_vtOriginals = {}
		end
	end,
})
